# Copy to /etc/zhidao/watchdog.env, chmod 600.
# Telegram alert delivery (use the existing bot token and your admin chat id).
ZHIDAO_ALERT_BOT_TOKEN=
ZHIDAO_ALERT_CHAT_ID=

# Optional overrides:
# ZHIDAO_DB_PATH=/root/zhidao.db
# ZHIDAO_WAL_LIMIT_BYTES=8388608
# ZHIDAO_WATCHDOG_JOURNAL_WINDOW=10 minutes ago
